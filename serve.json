{
  "public": ".",
  "cleanUrls": false,
  "directoryListing": false,
  "headers": [
    {
      "source": "**/*.@(mp3|ogg|wav)",
      "headers": [
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
